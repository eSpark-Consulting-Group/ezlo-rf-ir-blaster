  (text_box "CHANGELOG\nRevA: Initial release, based on IRBlaster revB\nmoved LEDs to center of PCBs, added test points, removed USB data connection, optimized DFM, added RF module."
    (at 176.53 120.65 0) (size 105.41 16.51)
    (stroke (width 0) (type default))
    (fill (type none))
    (effects (font (size 1.27 1.27) (thickness 0.254) bold) (justify left top))
    (uuid 6554182e-e798-451f-a2b0-e59dd81f318b)
  )

  (text "Strapping pins\n• BOOT = IO0\n• JTAG = IO3\n• VSPI = IO45\n• LOG = IO46\n\nSPI0/1: GPIO26-32 are usually used for SPI flash and PSRAM and not recommended for other uses.\nWhen using Octal Flash or Octal PSRAM or both, GPIO33~37 are connected to SPIIO4 ~ SPIIO7 and \nSPIDQS. Therefore on ESP32-S3R8 / ESP32-S3R8V board GPIO33~37 are also not recommended for \nother uses.\n\nFor 2MB PSRAM version (embedded chip ESP32-S3R2 quad SPI) pins IO35, IO36, IO37 should be free to use.\nFor 8MB PSRAM version (embedded chip ESP32-S3R8 octal SPI) pins IO35, IO36, IO37 connect to PSRAM and\nare not available for other uses.\n\nUSB-JTAG: GPIO 19 and 20 are used by USB-JTAG by default. In order to use them as GPIOs, \nUSB-JTAG will be disabled by the drivers.\n"
    (at 16.51 189.23 0)
    (effects (font (size 1.5 1.5)) (justify left bottom))
    (uuid 0a698140-4292-4700-99ab-60f93c8e258b)
  )
  (text "ESP32\n" (at 118.11 21.59 0)
    (effects (font (size 2.9972 2.9972) (thickness 0.5994) bold) (justify left bottom))
    (uuid 7fd78910-c8fa-4b8e-9ebc-95125a79a018)
  )
  (text "RMT peripheral used!" (at 171.45 58.42 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid c10ba9a1-d679-4c25-a842-c6eec4f6c8fe)
  )
  (text "TEST\n" (at 264.16 93.98 0)
